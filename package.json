{
	"name": "companion-module-lanternbird-cuecapture",
	"version": "1.0.0",
	"description": "Bitfocus Companion module for CueCapture — recording, playback, mix mode, overlays, meter panels.",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"postinstall": "husky",
		"format": "prettier -w .",
		"package": "run build && companion-module-build",
		"build": "rimraf dist && run build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"build:icons": "node scripts/build-icons.mjs",
		"slice:icons": "node scripts/slice-icon-grid.mjs",
		"test:osc": "run build && node scripts/osc-smoke-test.mjs",
		"dev": "tsc -p tsconfig.build.json --watch",
		"lint:raw": "eslint",
		"lint": "run lint:raw ."
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-lanternbird-cuecapture.git"
	},
	"engines": {
		"node": "^22.20",
		"yarn": "^4"
	},
	"dependencies": {
		"@companion-module/base": "2.0.4"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.0.2",
		"@types/node": "^22.19.17",
		"eslint": "^10.9.1",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"prettier": "^3.8.3",
		"rimraf": "^6.1.3",
		"sharp": "^0.35.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.68.0"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"prettier --write"
		],
		"*.{ts,tsx,js,jsx}": [
			"yarn lint:raw --fix"
		]
	},
	"packageManager": "yarn@4.12.0"
}
